{
  "name": "@scribase-mail/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Scribase Mail — send and manage email via the Model Context Protocol",
  "license": "MIT",
  "type": "module",
  "bin": {
    "scribase-mail-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["mcp", "email", "scribase", "resend"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "@usesend/eslint-config": "workspace:*",
    "@usesend/typescript-config": "workspace:*",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  }
}
