{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "db:generate"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "DATABASE_URL",
        "NODE_ENV",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "GITHUB_ID",
        "GITHUB_SECRET",
        "USESEND_API_KEY",
        "UNSEND_API_KEY",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "OCI_REGION",
        "OCI_COMPARTMENT_ID",
        "OCI_TENANCY",
        "OCI_USER",
        "OCI_FINGERPRINT",
        "OCI_PRIVATE_KEY",
        "OCI_PRIVATE_KEY_PATH",
        "OCI_PRIVATE_KEY_PASSPHRASE",
        "SMTP_PORT",
        "SMTP_PASS",
        "SUPPRESSION_POLL_CRON",
        "API_RATE_LIMIT",
        "AUTH_EMAIL_RATE_LIMIT",
        "NEXT_PUBLIC_IS_CLOUD",
        "NEXT_PUBLIC_APP_VERSION",
        "NEXT_PUBLIC_GIT_SHA",
        "ADMIN_EMAIL",
        "FOUNDER_EMAIL",
        "DISCORD_WEBHOOK_URL",
        "REDIS_URL",
        "REDIS_KEY_PREFIX",
        "FROM_EMAIL",
        "OCI_STORAGE_NAMESPACE",
        "OCI_STORAGE_BUCKET",
        "STORAGE_PUBLIC_URL",
        "DODO_PAYMENTS_API_KEY",
        "DODO_PAYMENTS_WEBHOOK_KEY",
        "DODO_PAYMENTS_ENVIRONMENT",
        "DODO_PRODUCT_ID_PRO",
        "DODO_PRODUCT_ID_SCALE",
        "DODO_USAGE_METER_ID",
        "DODO_USAGE_EVENT_NAME",
        "SMTP_HOST",
        "SMTP_USER",
        "SMTP_PUBLIC_HOST",
        "SMTP_PUBLIC_USER",
        "CONTACT_BOOK_ID",
        "EMAIL_CLEANUP_DAYS",
        "VERCEL_URL",
        "VERCEL",
        "SKIP_ENV_VALIDATION",
        "DOCKER_OUTPUT",
        "PORT",
        "RUN_INTEGRATION"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "db:generate"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}
