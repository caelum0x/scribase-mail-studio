DATABASE_URL="postgresql://usesend:password@localhost:54320/usesend"
REDIS_URL="redis://localhost:6379"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Oracle Cloud Email Delivery - SMTP relay used for sending
SMTP_HOST="smtp.email.eu-frankfurt-1.oci.oraclecloud.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Oracle Cloud Email Delivery - API (domains, DKIM, approved senders, suppressions)
OCI_REGION="eu-frankfurt-1"
OCI_TENANCY=""
OCI_USER=""
OCI_FINGERPRINT=""
# Either the PEM contents (\n escapes allowed) or a path to the key file
OCI_PRIVATE_KEY=""
# OCI_PRIVATE_KEY_PATH="/path/to/oci_api_key.pem"
# OCI_COMPARTMENT_ID="" # defaults to the tenancy

# System emails (sign-in codes, invites) are sent from this address via the relay
FROM_EMAIL="Scribase Mail <noreply@mail.example.com>"

API_RATE_LIMIT=2
AUTH_EMAIL_RATE_LIMIT=5

# Optional: prefix all Redis keys (useful for shared Redis with ACL isolation)
# REDIS_KEY_PREFIX=""

NEXT_PUBLIC_IS_CLOUD=false
