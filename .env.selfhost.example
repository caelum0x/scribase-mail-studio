# ---------------------------------------------------------------------------
# Scribase Mail - self-host configuration
# ---------------------------------------------------------------------------

# Public URL of the app (also used for tracking and unsubscribe links) - required
NEXTAUTH_URL="https://mail.example.com"
# Random secret: openssl rand -base64 32 - required
NEXTAUTH_SECRET=

# Postgres - required (compose builds DATABASE_URL from these)
POSTGRES_USER="scribase_mail"
POSTGRES_PASSWORD="<long-random-password>"
POSTGRES_DB="scribase_mail"
DATABASE_URL="postgresql://scribase_mail:<long-random-password>@postgres:5432/scribase_mail"

# Redis - required
REDIS_URL="redis://redis:6379"

# Oracle Cloud Email Delivery: SMTP credentials (sending) - required
SMTP_HOST="smtp.email.eu-frankfurt-1.oci.oraclecloud.com"
SMTP_PORT="587"
SMTP_USER="<oci-smtp-credential-username>"
SMTP_PASS="<oci-smtp-credential-password>"

# Oracle Cloud Email Delivery: API signing key - required
OCI_REGION="eu-frankfurt-1"
OCI_TENANCY="ocid1.tenancy.oc1..<...>"
OCI_USER="ocid1.user.oc1..<...>"
OCI_FINGERPRINT="<api-key-fingerprint>"
# PEM contents with \n escapes, or mount the key and set OCI_PRIVATE_KEY_PATH
OCI_PRIVATE_KEY=""
# OCI_PRIVATE_KEY_PATH="/run/secrets/oci_api_key.pem"
# OCI_COMPARTMENT_ID="ocid1.compartment.oc1..<...>" # defaults to the tenancy

# Address for sign-in codes and notifications. Must be on a domain that is
# set up in OCI Email Delivery - required for email login
FROM_EMAIL="Scribase Mail <noreply@mail.example.com>"
# Admin user (sees Admin > Email provider)
ADMIN_EMAIL="you@example.com"

## Optional OAuth login
# GITHUB_ID=""
# GITHUB_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Shown to customers on the SMTP settings page (apps/smtp-server)
# SMTP_PUBLIC_HOST="smtp.mail.example.com"
# SMTP_PUBLIC_USER="scribase"

# Bounce/complaint polling of the OCI suppression list (cron, UTC)
# SUPPRESSION_POLL_CRON="*/5 * * * *"

# Delivered/bounced/complained events from the OCI Email Delivery logs
# (Logging Search poll, cron UTC) and the log group they are written to
# DELIVERY_LOG_POLL_CRON="* * * * *"
# OCI_LOG_GROUP_NAME="scribase-mail"

# Image uploads in the editor (OCI Object Storage) - optional
# OCI_STORAGE_NAMESPACE=""
# OCI_STORAGE_BUCKET=""
# STORAGE_PUBLIC_URL=""

DOCKER_OUTPUT=1
API_RATE_LIMIT=1
AUTH_EMAIL_RATE_LIMIT=5

# Optional: prefix all Redis keys (useful for shared Redis with ACL isolation)
# REDIS_KEY_PREFIX=""

# Optional: clear stored email content after this many days (daily, midnight UTC)
# EMAIL_CLEANUP_DAYS=30

# Optional: important error notifications
# DISCORD_WEBHOOK_URL=""
